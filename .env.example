# Vercel's Neon/Postgres integration sets this automatically once you add the
# Storage integration in the Vercel dashboard -- you shouldn't need to set it
# by hand for a real deployment.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Only needed for local (non-Vercel) testing, where the domain isn't known
# automatically. WebAuthn allows "localhost" as an https exception.
# RP_ID=localhost
# ORIGIN=http://localhost:3000
